# Local-only automation (personal push helpers)
scripts/

# TLS / corporate CA material (never commit)
artifactory/certs/*
!artifactory/certs/.gitkeep
gdrive/certs/*
!gdrive/certs/.gitkeep
github/certs/*
!github/certs/.gitkeep

# Secrets and local-only files
**/.env
**/.env.local
**/.env.*.local
**/credentials.json
**/token.json

# Dependencies and build output
node_modules/
dist/
build/

# Test coverage and local tooling
coverage/
.claude/
**/__pycache__/
**/.pytest_cache/
**/.venv/
.verify-venv/
*.log

# Local TLS certs (never commit private keys or corporate bundles)
**/certs/*
!mcp-gateway/certs/README.md
!mcp-gateway/certs/build-ca-bundle.sh
!mcp-gateway/certs/.gitkeep
*.pem
*.key

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
